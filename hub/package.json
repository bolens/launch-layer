{
  "name": "launchlayer-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "convex dev",
    "convex:deploy": "convex deploy",
    "test": "pnpm run test:unit && pnpm run test:convex",
    "test:unit": "tsx --test convex/lib/*.test.ts",
    "test:convex": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "tsx --test --experimental-test-coverage convex/lib/*.test.ts && vitest run --coverage",
    "lint": "eslint . && tsc -p convex/tsconfig.json --noEmit",
    "typecheck": "tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "convex": "1.42.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "1.2.2",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "convex-test": "0.0.54",
    "eslint": "9.39.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
